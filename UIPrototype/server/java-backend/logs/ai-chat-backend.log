import csv
import os
from typing import Dict, List, Optional

def calculate_statistics(file_path: str) -> Optional[Dict[str, float]]:
    """
    计算CSV文件中数值列的统计信息（平均值、总和、最大值、最小值）
    
    Args:
        file_path (str): CSV文件路径
        
    Returns:
        Optional[Dict[str, float]]: 包含统计信息的字典，若出错则返回None
        
    Raises:
        FileNotFoundError: 如果文件不存在
        ValueError: 如果文件中没有数值列或格式错误
    """
    # 检查文件是否存在
    if not os.path.exists(file_path):
        raise FileNotFoundError(f"文件不存在: {file_path}")

    # 初始化统计结果字典
    statistics = {
        'total': 0,
        'average': 0.0,
        'max': float('-inf'),
        'min': float('inf')
    }

    try:
        # 使用上下文管理器安全打开文件
        with open(file_path, mode='r', encoding='utf-8') as csvfile:
            reader = csv.DictReader(csvfile)
            
            # 检查是否至少有一列
            if not reader.fieldnames:
                raise ValueError("CSV文件没有列标题")
                
            # 假设只处理第一个数值列（可根据需求扩展）
            numeric_columns = [col for col in reader.fieldnames if is_numeric_column(reader, col)]
            
            if not numeric_columns:
                raise ValueError("没有找到数值列")
                
            column_name = numeric_columns[0]
            
            # 遍历每一行数据
            for row in reader:
                try:
                    value = float(row[column_name])
                    statistics['total'] += value
                    statistics['average'] = statistics['total'] / reader.line_num
                    statistics['max'] = max(statistics['max'], value)
                    statistics['min'] = min(statistics['min'], value)
                except
