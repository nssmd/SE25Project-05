            c1_0.user_id 
        from
            chats c1_0 
        where
            c1_0.user_id=? 
            and (
                ? is null 
                or c1_0.title like replace(?, '\\', '\\\\')
            ) 
            and (
                ? is null 
                or c1_0.ai_type=?
            ) 
            and (
                ? is null 
                or c1_0.is_favorite=?
            ) 
            and (
                ? is null 
                or c1_0.last_activity>=?
            ) 
        order by
            c1_0.last_activity desc 
        limit
            ?, ?
